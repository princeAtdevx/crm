# Committed on purpose: no secrets, just a pointer at the throwaway local
# database that every test suite uses. This is the ONE definition of it --
# apps/backend's ConfigModule, @crm/db's integration suite and
# `pnpm dev:db:migrate:test` all read this file.
#
# Loaded ahead of .env whenever NODE_ENV=test, which vitest sets on its own.
# Anything you cannot commit (a real key, a different port) goes in
# .env.test.local, which is gitignored and loaded first.
#
# The database name must end in _test: packages/db/test/test-db.ts refuses to
# run against anything else, so a slip here fails loudly instead of truncating
# the database you have been clicking around in all morning.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/crm_test
PORT=3001
NODE_ENV=test
