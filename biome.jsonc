{
	"$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",

	// Biome project root. Each workspace carries its own `biome.jsonc` with
	// `"root": false, "extends": "//"` holding only its deltas.
	"root": true,

	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true,
		"defaultBranch": "main"
	},

	"files": {
		"ignoreUnknown": true,
		"includes": [
			"**",
			"!**/node_modules",
			"!**/dist",
			"!**/.turbo",
			"!**/.next",
			"!**/coverage",
			"!**/*.tsbuildinfo",
			// Generated by drizzle-kit; huge and meaningless to format.
			"!**/drizzle/**/snapshot.json"
		]
	},

	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 4,
		"lineWidth": 100,
		"lineEnding": "lf",
		// biome.jsonc is the source of truth; .editorconfig exists for editors
		// and for the file types Biome does not handle (md, yaml).
		"useEditorconfig": false
	},

	"javascript": {
		"formatter": {
			"quoteStyle": "single",
			"jsxQuoteStyle": "double",
			"trailingCommas": "all",
			"semicolons": "always",
			"arrowParentheses": "always"
		},
		"parser": {
			// Nest uses parameter decorators (@Body(), @Inject(), @Param()).
			// Without this Biome fails to parse the controllers outright.
			"unsafeParameterDecoratorsEnabled": true
		},
		"resolver": {
			// Dependency-aware rules must understand the `catalog:` protocol
			// used in pnpm-workspace.yaml, otherwise every catalogued dep
			// looks undeclared.
			"experimentalPnpmCatalogs": true
		}
	},

	"json": {
		"formatter": {
			"enabled": true
		}
	},

	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,

			// `nest new` default: '@typescript-eslint/no-explicit-any': 'off'
			"suspicious": {
				"noExplicitAny": "off"
			},

			"correctness": {
				"noUnusedImports": "error",
				"noUnusedVariables": "error",
				"noUnusedFunctionParameters": "error",
				// warn, not error: Bun-resolved and type-only imports
				// (e.g. vitest/globals) can trip it.
				"noUndeclaredDependencies": "warn"
			},

			// OFF repo-wide because of NestJS DI (emitDecoratorMetadata needs
			// value imports for constructor-injected types). Re-enabled in
			// packages/db, which has no decorators.
			"style": {
				"useImportType": "off"
			},

			// Type-aware rules. `nest new` sets no-floating-promises to 'warn'.
			"nursery": {
				"noFloatingPromises": "warn",
				"noMisusedPromises": "warn",
				"useAwaitThenable": "warn"
			}
		}
	},

	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				// Sorts only. Converting to `import type` is useImportType's
				// job, and that stays off where Nest DI is involved.
				"organizeImports": "on"
			}
		}
	},

	"overrides": [
		{
			// These carry load-bearing comments.
			"includes": ["**/tsconfig*.json", "**/nest-cli.json", "**/.vscode/*.json"],
			"json": {
				"parser": {
					"allowComments": true,
					"allowTrailingCommas": true
				}
			}
		}
	]
}
