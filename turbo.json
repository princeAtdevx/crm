{
	"$schema": "https://turborepo.dev/schema.json",
	"ui": "tui",
	"globalDependencies": ["biome.jsonc", ".editorconfig"],
	"tasks": {
		"lint": {
			"dependsOn": ["^lint"],
			// Biome reads none of these, so an edit to them must not bust the
			// lint cache. $TURBO_DEFAULT$ keeps .gitignore awareness.
			"inputs": ["$TURBO_DEFAULT$", "!**/*.md", "!**/*.sql", "!.env*"],
			"outputs": []
		},
		"lint:fix": {
			"cache": false
		},
		"format": {
			"cache": false
		},
		"format:check": {
			"inputs": ["$TURBO_DEFAULT$", "!**/*.md", "!**/*.sql", "!.env*"],
			"outputs": []
		},
		"build": {
			// check-types is a sibling task, not part of the build script, but
			// the Vite template's `tsc -b && vite build` behaviour is worth
			// keeping: no bundle is emitted from code that fails type checking.
			"dependsOn": ["^build", "check-types"],
			"outputs": ["dist/**"]
		},
		"check-types": {
			"dependsOn": ["^check-types"],
			"outputs": []
		},
		"test": {
			"outputs": []
		},
		"clean": {
			"cache": false
		},
		"dev": {
			"cache": false,
			"persistent": true
		}
	}
}
