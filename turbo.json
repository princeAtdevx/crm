{
	"$schema": "https://turborepo.dev/schema.json",
	"ui": "tui",
	"globalDependencies": ["biome.jsonc", ".editorconfig"],
	"tasks": {
		"lint": {
			"dependsOn": ["^lint"],
			"outputs": []
		},
		"lint:fix": {
			"cache": false
		},
		"format": {
			"cache": false
		},
		"format:check": {
			"outputs": []
		},
		"check-types": {
			"dependsOn": ["^check-types"],
			"outputs": []
		},
		"test": {
			"outputs": []
		},
		"clean": {
			"cache": false
		},
		"dev": {
			"cache": false,
			"persistent": true
		}
	}
}
