{
	"$schema": "https://turborepo.dev/schema.json",
	"ui": "tui",
	"globalDependencies": ["biome.jsonc", ".editorconfig"],

	// Turbo 2 defaults to `envMode: "strict"`: a task sees ONLY the variables
	// declared here. An omission is not "inherited but uncached" — the variable
	// is absent inside the task, so it surfaces as a config validation error at
	// boot rather than as a cache miss. Biome's noUndeclaredEnvVars rule reads
	// this file and flags any process.env access missing from it.
	//
	// NODE_ENV is in globalEnv because it changes what tasks produce. Everything
	// else is globalPassThroughEnv: reachable by tasks, but not part of the
	// cache key — pointing DATABASE_URL at a different local database should not
	// invalidate a lint or build result.
	"globalEnv": ["NODE_ENV"],
	"globalPassThroughEnv": [
		"DATABASE_URL",
		"PORT",
		// Read by scripts/preflight-db.mjs and docker/compose.yml.
		"POSTGRES_PORT",
		"SKIP_DB_CHECK",
		// OBSERVE_ENDPOINT is read by @nestjs/observe itself, not by our code.
		"OBSERVE_APP_KEY",
		"OBSERVE_APP_SECRET",
		"OBSERVE_SERVICE_ID",
		"OBSERVE_SERVICE_VERSION",
		"OBSERVE_ENDPOINT"
	],
	"tasks": {
		"lint": {
			"dependsOn": ["^lint"],
			// Biome reads none of these, so an edit to them must not bust the
			// lint cache. $TURBO_DEFAULT$ keeps .gitignore awareness.
			"inputs": ["$TURBO_DEFAULT$", "!**/*.md", "!**/*.sql", "!.env*"],
			"outputs": []
		},
		"lint:fix": {
			"cache": false
		},
		"format": {
			"cache": false
		},
		"format:check": {
			"inputs": ["$TURBO_DEFAULT$", "!**/*.md", "!**/*.sql", "!.env*"],
			"outputs": []
		},
		"build": {
			// check-types is a sibling task, not part of the build script, but
			// the Vite template's `tsc -b && vite build` behaviour is worth
			// keeping: no bundle is emitted from code that fails type checking.
			"dependsOn": ["^build", "check-types"],
			"outputs": ["dist/**"]
		},
		"check-types": {
			"dependsOn": ["^check-types"],
			"outputs": []
		},
		"test": {
			"outputs": []
		},
		"clean": {
			"cache": false
		},
		"dev": {
			"cache": false,
			"persistent": true
		}
	}
}
