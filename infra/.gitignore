# Local Terraform working state -- never committed, regenerated by `init`.
**/.terraform/
.terraform.lock.hcl

# State files -- even though remote state is the intended backend, a
# infra/bootstrap apply run before backend.tfvars exists elsewhere
# writes local state, and that must never land in git (it contains
# resource IDs and, depending on resources involved, secret material).
*.tfstate
*.tfstate.*

# Real variable values -- only the .example files are committed.
terraform.tfvars
backend.tfvars

# Plan output files, if anyone saves one locally for review.
*.tfplan
crash.log
crash.*.log
