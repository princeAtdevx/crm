{
	"$schema": "https://json.schemastore.org/tsconfig",
	"extends": "@crm/ts-config/base.json",
	"compilerOptions": {
		"lib": ["ES2023"],
		"types": ["node"],

		"module": "preserve",
		"moduleResolution": "bundler",
		"verbatimModuleSyntax": true,
		"noEmit": true,

		"noFallthroughCasesInSwitch": true,
		"noImplicitOverride": true
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules"]
}
