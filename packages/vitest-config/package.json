{
	"name": "@crm/vitest-config",
	"version": "0.0.0",
	"description": "Shared Vitest presets. Source-only, like every other @crm package.",
	"private": true,
	"type": "module",
	"exports": {
		"./base": "./src/base.ts",
		"./node": "./src/node.ts",
		"./react": "./src/react.ts",
		"./setup/react": "./src/setup/react.ts",
		"./package.json": "./package.json"
	},
	"scripts": {
		"check-types": "tsc -p tsconfig.json --noEmit",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"clean": "rm -rf .turbo coverage *.tsbuildinfo"
	},
	"dependencies": {
		"@testing-library/jest-dom": "catalog:",
		"@testing-library/react": "catalog:",
		"@vitest/coverage-v8": "catalog:",
		"jsdom": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:"
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"@crm/ts-config": "workspace:*",
		"@types/node": "catalog:",
		"typescript": "catalog:"
	},
	"license": "UNLICENSED"
}
