{
	"$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
	"root": false,
	"extends": "//",

	"linter": {
		"domains": {
			// vitest globals + noFocusedTests.
			"test": "recommended"
		},
		"rules": {
			"style": {
				// Same reason as packages/db: verbatimModuleSyntax is on, so a
				// type-only import must be marked or it is emitted for real.
				"useImportType": "error"
			}
		}
	}
}
