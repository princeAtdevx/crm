{
	"name": "@crm/utils",
	"version": "1.0.0",
	"description": "Framework-agnostic helpers shared across workspaces.",
	"private": true,
	"type": "module",
	"scripts": {
		"check-types": "tsc -p tsconfig.json --noEmit",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"clean": "rm -rf dist .turbo coverage *.tsbuildinfo"
	},
	"exports": {
		".": "./src/index.ts",
		"./package.json": "./package.json"
	},
	"dependencies": {},
	"devDependencies": {
		"@crm/ts-config": "workspace:*",
		"@types/node": "catalog:"
	},
	"keywords": [],
	"author": "",
	"license": "ISC"
}
