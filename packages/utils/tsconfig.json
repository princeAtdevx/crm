{
	"$schema": "https://json.schemastore.org/tsconfig",
	"extends": "@crm/ts-config/base.json",
	"compilerOptions": {
		// Server-only package: no DOM libs.
		"lib": ["ES2023"],
		// vitest/globals because the shared preset sets `globals: true`;
		// without it describe/it/expect are unresolved to tsc.
		"types": ["node", "vitest/globals"],

		// Bun runs this TypeScript directly and there is no build, so tsc only
		// ever type-checks. "bundler" resolution is what permits the
		// extension-less relative imports below.
		"module": "preserve",
		"moduleResolution": "bundler",
		"verbatimModuleSyntax": true,
		"noEmit": true,

		"noFallthroughCasesInSwitch": true,
		"noImplicitOverride": true
	},
	"include": ["src/**/*", "vitest.config.ts"],
	"exclude": ["node_modules"]
}
