			"author": null,
			"contributor": null,
			"rationale": "Category (in-process, local-substitutable, remote-but-owned, true-external) determines how the deepened module is tested across its seam."
		},
		{
			"id": "claude_skills_codebase_design_deepening_seam_discipline",
			"label": "Seam Discipline",
			"file_type": "concept",
			"source_file": ".claude/skills/codebase-design/DEEPENING.md",
			"source_location": null,
			"source_url": null,
			"captured_at": null,
			"author": null,
			"contributor": null,
			"rationale": "One adapter means a hypothetical seam; two adapters means a real one, so a port shouldn't be introduced unless at least two adapters are justified."
		},
		{
			"id": "claude_skills_codebase_design_deepening_testing_strategy",
			"label": "Replace-Don't-Layer Testing",
			"file_type": "concept",
			"source_file": ".claude/skills/codebase-design/DEEPENING.md",
			"source_location": null,
			"source_url": null,
			"captured_at": null,
			"author": null,
			"contributor": null,
			"rationale": "Old unit tests on shallow modules become waste once interface-level tests exist; the interface is the test surface, so tests should survive internal refactors."
		}
	],
