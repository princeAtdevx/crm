		{
			"id": "claude_skills_diagnosing_bugs_skill_phase1_feedback_loop",
			"label": "Phase 1: Build Feedback Loop",
			"file_type": "concept",
			"source_file": ".claude/skills/diagnosing-bugs/SKILL.md",
			"source_location": null,
			"source_url": null,
			"captured_at": null,
			"author": null,
			"contributor": null,
			"rationale": "The skill itself: a tight, red-capable, deterministic, fast, agent-runnable pass/fail signal. With it, bisection/hypothesis-testing/instrumentation find the cause; without it, no amount of staring at code helps."
		},
		{
			"id": "claude_skills_diagnosing_bugs_skill_phase2_reproduce_minimise",
			"label": "Phase 2: Reproduce + Minimise",
			"file_type": "concept",
			"source_file": ".claude/skills/diagnosing-bugs/SKILL.md",
			"source_location": null,
			"source_url": null,
			"captured_at": null,
			"author": null,
			"contributor": null,
			"rationale": "Shrinking to the smallest scenario that still goes red narrows the hypothesis space and becomes the later regression test."
		},
		{
			"id": "claude_skills_diagnosing_bugs_skill_phase3_hypothesise",
			"label": "Phase 3: Hypothesise",
			"file_type": "concept",
			"source_file": ".claude/skills/diagnosing-bugs/SKILL.md",
			"source_location": null,
			"source_url": null,
			"captured_at": null,
			"author": null,
			"contributor": null,
			"rationale": "Generate 3-5 ranked falsifiable hypotheses before testing any, since single-hypothesis generation anchors on the first plausible idea."
		},
		{
			"id": "claude_skills_diagnosing_bugs_skill_phase4_instrument",
			"label": "Phase 4: Instrument",
			"file_type": "concept",
			"source_file": ".claude/skills/diagnosing-bugs/SKILL.md",
			"source_location": null,
			"source_url": null,
			"captured_at": null,
			"author": null,
			"contributor": null,
			"rationale": "Each probe maps to a specific prediction, changing one variable at a time; tagged debug logs make cleanup a single grep."
		},
		{
			"id": "claude_skills_diagnosing_bugs_skill_phase5_fix_regression_test",
			"label": "Phase 5: Fix + Regression Test",
			"file_type": "concept",
			"source_file": ".claude/skills/diagnosing-bugs/SKILL.md",
			"source_location": null,
			"source_url": null,
			"captured_at": null,
			"author": null,
			"contributor": null,
			"rationale": "Write the regression test before the fix only if a correct seam exists; if no correct seam exists, that absence is itself the finding about the codebase's architecture."
		},
		{
			"id": "claude_skills_diagnosing_bugs_skill_phase6_cleanup",
			"label": "Phase 6: Cleanup",
