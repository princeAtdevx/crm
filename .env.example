# Copy to .env and adjust. Loaded by apps/backend (via @nestjs/config) and by
# packages/db's drizzle.config.ts and seed — one source of truth for the repo.
#
# The host and port below match the Postgres in docker/compose.yml, started
# with `pnpm db:start`. If 5432 is taken on your machine, publish another port
# (`POSTGRES_PORT=5433 pnpm db:start`) and change it here too.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/crm
PORT=3000
NODE_ENV=development

# --- Telemetry (optional) --------------------------------------------------
# NestJS Observe (https://observe.nestjs.com). Leave both blank and the agent is
# never registered; set BOTH or boot fails, since one half alone yields a
# collector that rejects every batch. Real values belong in .env.local, which is
# gitignored.
# OBSERVE_APP_KEY=
# OBSERVE_APP_SECRET=
# OBSERVE_SERVICE_ID=backend
# OBSERVE_SERVICE_VERSION=
