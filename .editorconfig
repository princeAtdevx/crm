# Keep in sync with biome.jsonc. For the file types Biome owns (ts, js, json,
# jsonc, css, graphql) biome.jsonc is authoritative and overrides this file;
# these settings exist for editors and for md/yaml, which Biome cannot format.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 4
max_line_length = 100

# YAML forbids tabs for indentation.
[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

[*.sql]
indent_style = space
indent_size = 2
